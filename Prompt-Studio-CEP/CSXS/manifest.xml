<?xml version="1.0" encoding="UTF-8"?>
<!--
  Prompt Studio — CEP manifest.
  Works WITHOUT Creative Cloud / UXP Developer Tool.
  Photoshop 2020 (v21, CEP 9) · 2021 (v22, CEP 10) · 2022+ (CEP 11/12).
-->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.promptstudio.cep" ExtensionBundleVersion="1.2.0" ExtensionBundleName="EMG" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.promptstudio.cep.panel" Version="1.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PHXS" Version="[21.0,99.9]" />
      <Host Name="PHSP" Version="[21.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.promptstudio.cep.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--enable-webgl</Parameter>
            <Parameter>--ignore-gpu-blocklist</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>EMG</Menu>
          <Geometry>
            <Size>
              <Height>880</Height>
              <Width>460</Width>
            </Size>
            <MinSize>
              <Height>420</Height>
              <Width>310</Width>
            </MinSize>
            <MaxSize>
              <Height>5000</Height>
              <Width>2000</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
